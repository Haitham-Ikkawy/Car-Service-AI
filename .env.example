# Car Service AI — environment configuration
# Copy this file to ".env" and fill in your values.

# Google Gemini API key (https://aistudio.google.com/apikey)
# If left empty, the app runs in DEMO MODE (all AI features still work with mock data).
GEMINI_API_KEY=

# Gemini model to use (defaults to the newest supported Flash model — gemini-3.6-flash).
# Supported: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Secret used to sign session cookies. Change this in production.
SESSION_SECRET=change-me-car-service-ai-secret

# Google OAuth 2.0 — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (type: Web application).
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
# Leave empty to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
